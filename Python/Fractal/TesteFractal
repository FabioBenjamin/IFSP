def quadrado(t, tamanho):
    for i in range(4):
        t.forward(tamanho)
        t.left(90)

def tamanhoTela(tamanho):

    # Posição atual
    a = abs(ay.xcor())
    b = abs(ay.ycor())

    # Tamanho da janela
    largura = tela.window_width()
    altura = tela.window_height()

    limiteA = largura * 0.40
    limiteB = altura * 0.40

    # Verificação da borda
    expansao = (a > limiteA or
                b > limiteB or
                tamanho > limiteA or
                tamanho > limiteB)

    if expansao:
        larguraNova = min(largura + 300, larguraMaxima)
        alturaNova = min(altura + 200, alturaMaxima)

        tela.setup(width = int(larguraNova), height = int(alturaNova))

def espirral(t, tamanhos, numeros, componente):

    menor = min(numeros)
    maior = max(numeros)

    for tamanho, numero in zip(tamanhos, numeros):

        # Normaliza o Fibonacci entre 0 e 255
        if maior == menor:
            valor = 255
        else:
            valor = int(
                255 * (numero - menor) / (maior - menor)
            )

        # Cria RGB
        rgb = [0, 0, 0]
        rgb[componente] = valor

        # Aplicação
        t.color(rgb[0], rgb[1], rgb[2])

        # Criação do desenho
        quadrado(t, tamanho)
        t.circle(tamanho, 90)

numeros = Fibonacci(int(perguntaTamanho))

tamanhos = numeros.copy()

espirral(ay, tamanhos ,numeros, componente)

turtle.done()
