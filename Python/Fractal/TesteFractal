import turtle

turtle.colormode(255)
tela = turtle.Screen()

larguraMaxima = tela.cv.winfo_screenwidth()
alturaMaxima = tela.cv.winfo_screenheight()
tela.setup(width = larguraMaxima, height = alturaMaxima)

ay = turtle.Turtle()
ay.speed(10)
ay.pensize(3)

def Fibonacci(n):
    sequencia = [1, 1]

    while len(sequencia) < n:
        proximo = sequencia[-1] + sequencia[-2]
        sequencia.append(proximo)

    return sequencia


# Descobrir limite

largura = tela.window_width()
altura = tela.window_height()
limite = min(largura, altura) * 0.4

n = 1
while True:

    Numero = Fibonacci(n)

    if max(Numero) > limite:
        break

    n += 1

maximo = n - 1

